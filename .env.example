# DocuMatch Architect Configuration
# Copy this file to .env and adjust values as needed

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
DEFAULT_MODEL=phi3.5
FALLBACK_MODEL=llama3.2

# ChromaDB Configuration
CHROMA_PERSIST_DIR=./data/chroma_db

# Parser Configuration
PARSER_FALLBACK_ENABLED=true
MAX_FILE_SIZE_MB=50

# Chunking Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/documatch.log

# Data Directories
CONTRACTS_DIR=./data/contracts
INVOICES_DIR=./data/invoices
PURCHASE_ORDERS_DIR=./data/purchase_orders

# API security and browser access
# Comma-separated JSON array of exact browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8501"]
# Set false in production if interactive API documentation is not needed.
API_DOCS_ENABLED=true

# Three-Way Matching Configuration
MATCH_TOLERANCE=0.01
